# Tout (token, salons, rôles, types de tickets) se configure désormais
# depuis le dashboard web (http://localhost:3000 par défaut).
# Ces variables sont optionnelles, uniquement pour le serveur du dashboard lui-même.

# Port d'écoute du dashboard
DASHBOARD_PORT=3000

# Interface d'écoute (0.0.0.0 = accessible depuis l'extérieur, 127.0.0.1 = local uniquement)
DASHBOARD_HOST=0.0.0.0

# --- Protection VPN/Proxy (vpnGuard) ---
# Clé API IPQualityScore, utilisée pour bloquer les connexions VPN/proxy/Tor sur le dashboard
# https://www.ipqualityscore.com/user/settings
IPQS_API_KEY=PLWszDYn4udIuMSoOubuzzp0a77Aosn7

# Si l'API IPQS tombe en panne : true = laisse passer, false = bloque tout le monde
VPN_GUARD_FAIL_OPEN=true
